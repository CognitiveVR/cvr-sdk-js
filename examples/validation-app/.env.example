# Copy this file to .env (same folder) and fill in real values, then run:
#   node examples/validation-app/generate-config.mjs
#
# Never commit .env — it holds real Application API keys. This .env.example
# file is committed and must only ever contain placeholders.
#
# Get the Application API Key (DATA-scoped) and Scene ID/Version from the
# Cognitive3D dashboard for the project you want to validate against.

# --- Dev environment (data.c3ddev.com) ---
C3D_APPLICATION_API_KEY_DEV=
C3D_SCENE_NAME_DEV=
C3D_SCENE_ID_DEV=
C3D_SCENE_VERSION_DEV=1

# --- Prod environment (data.cognitive3d.com) ---
C3D_APPLICATION_API_KEY_PROD=
C3D_SCENE_NAME_PROD=
C3D_SCENE_ID_PROD=
C3D_SCENE_VERSION_PROD=1
